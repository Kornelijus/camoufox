# Camoufox Branding Configuration
# 
# This file centralizes all browser branding settings.
# Change these values to customize the browser name and vendor information.
# 
# Use cases:
# 1. Keep "Firefox" branding to reduce fingerprinting surface area
# 2. Customize branding for private forks
#
# After changing this file, run: make copy-additions (or make retag-baseline)

# Product Names
# -------------
# BRAND_SHORT_NAME: Short product name (e.g., "Firefox", "Camoufox")
# Used in: UI elements, shortcuts, app name
BRAND_SHORT_NAME=Camoufox

# BRAND_FULL_NAME: Full product name (e.g., "Mozilla Firefox", "Camoufox")
# Used in: About dialog, installers
BRAND_FULL_NAME=Camoufox

# BRAND_VENDOR: Vendor/Organization name (e.g., "Mozilla", "Camoufox")
# Used in: MOZ_APP_VENDOR, profile paths, user agent (if exposed)
BRAND_VENDOR=Camoufox

# Application Settings
# --------------------
# APP_NAME: Lowercase app identifier (e.g., "firefox", "camoufox")
# Used in: Binary name, internal app name
APP_NAME=camoufox

# APP_PROFILE: Profile directory name (e.g., "firefox", "camoufox")
# Used in: Profile folder location (~/.APP_PROFILE)
APP_PROFILE=camoufox

# Branding Directory
# ------------------
# BRANDING_DIR: Directory name under browser/branding/ (e.g., "camoufox", "firefox")
# Note: The actual branding assets (icons, etc.) must exist in this directory
BRANDING_DIR=camoufox

# Notes:
# ------
# - To use Firefox branding for stealth: Set BRAND_SHORT_NAME=Firefox, BRAND_VENDOR=Mozilla
# - The BRANDING_DIR determines which icon/asset pack is used
# - Profile/app names can stay unique (camoufox) while display names appear as Firefox
# - User-Agent is separately controlled via MaskConfig at runtime (not affected by these settings)
