# Camoufox Branding Configuration (Firefox Stealth Mode)
# 
# This configuration keeps Firefox branding to reduce fingerprinting surface area.
# Browser will appear as "Firefox" in UI while maintaining unique profile/app paths.

# Product Names - Using Firefox for stealth
BRAND_SHORT_NAME=Firefox
BRAND_FULL_NAME=Mozilla Firefox
BRAND_VENDOR=Mozilla

# Application Settings - Keep unique to avoid conflicts with real Firefox
APP_NAME=camoufox
APP_PROFILE=camoufox

# Branding Directory - Use existing camoufox icons
BRANDING_DIR=camoufox
